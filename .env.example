# =============================================================================
# VAYU — environment. EVERY KEY IS OPTIONAL. The app runs fully with none set.
# Copy to .env:  cp .env.example .env
# =============================================================================

# -- Demo -------------------------------------------------------------------
# true  = bundled sample data only, fully offline, scheduler disabled, "now"
#         pinned to DEMO_NOW so the demo timeline is deterministic/rehearsable.
# false = live feeds where keys/free APIs allow, falling back to samples.
DEMO_MODE=true

# "Now" during DEMO_MODE. Pinned inside the bundled data window to a REAL Delhi
# stubble-season episode, chosen from MEASURED CPCB data (not model output):
# city AQI 254 (Poor) on 3 Nov rises to 351 (Very Poor) by 5 Nov -- a genuine
# AQI-300 crossing ~48h out, during peak Punjab/Haryana stubble burning. The
# hazard the demo forecasts is a real event, not a synthetic spike.
DEMO_NOW=2025-11-03T06:00:00Z

# -- Free APIs that need NO key --------------------------------------------
# Open-Meteo (weather + CAMS air quality)  : no key, no signup
# OSM Overpass                             : no key
# datameet ward boundaries                 : no key

# Open-Meteo is FREE and needs NO key — VAYU's whole 1.47M-row weather archive
# was fetched without one. Set this only if you hit rate limits on a deep
# backfill (the free tier is priced by data volume, not request count), or if
# you deploy commercially (the free tier is non-commercial use only).
OPEN_METEO_API_KEY=

# -- Optional keys (each upgrades a layer from 'sample'/'cached' to 'live') --

# CPCB CAAQMS real-time feed via data.gov.in. Ships with the portal's public
# demo key, so this works out of the box; register at data.gov.in for your own
# (higher rate limit). Provides REAL station names/coords/current values.
DATA_GOV_IN_API_KEY=

# OpenAQ v3 — free at https://openaq.org. When present, station MEASUREMENTS
# replace the CAMS reanalysis series (see docs/DATA_PROVENANCE.md).
OPENAQ_API_KEY=

# NASA FIRMS — free at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Fire detections for the Attributor (Phase 3). Falls back to bundled 7-day CSV.
FIRMS_API_KEY=

# Anthropic — optional: live LLM advisories + GRAP RAG answers.
# Without it, VAYU serves pre-generated advisories from data/samples/llm_cache.json.
ANTHROPIC_API_KEY=

# -- Google AI (Gemini) — citizen photo analysis + advisories ----------------
# Free at https://aistudio.google.com/apikey. Without it, citizen photo
# reports are stored but never classified (no haze/source-type read), and
# /citizen/reports.google_ai_enabled reports false rather than guessing.
GOOGLE_API_KEY=
# Pinned to a concrete version deliberately — see vayu_core/config.py.
GEMINI_MODEL=gemini-3.6-flash
# Vertex AI path (optional alternative to GOOGLE_API_KEY): set both to route
# through a GCP project instead of an AI Studio key.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1

# Google Earth Engine service account JSON (path) — national NO2/CO/AOD
# ingestion (services/pipeline/satellite.py). Layer hides gracefully when
# absent; HCHO/SO2/O3 still come from DLR's keyless Sentinel-5P STAC.
GEE_SERVICE_ACCOUNT_JSON=

# -- Live mode (Phase L) — all optional; demo runs without any of these -------
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -- Wiring -----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
VAYU_DB_PATH=data/vayu.duckdb
# Optional: Mappls (MapmyIndia) key enables the official India-boundary basemap.
# Until set, the map falls back to Carto (dark/light) + Esri (satellite).
NEXT_PUBLIC_MAPPLS_KEY=
